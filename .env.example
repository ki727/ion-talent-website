# ION Talent website — required environment variables.
# Copy to .env.local for local development and fill in real values there.
# Never commit .env.local or any file containing real credentials.

# SMTP transport (Google Workspace, authenticated with an app password — never the account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-authenticated-mailbox@example.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM="ION Talent" <noreply@example.com>

# Recipients — one destination per submission type, never shared or re-routed
HIRING_ENQUIRY_TO=info@example.com
APPLICATION_TO=apply@example.com
REFERRAL_TO=referral@iontalentgroup.com

# Local development only — relaxes TLS certificate verification for this SMTP
# connection when NODE_ENV is not "production". Never set this in Vercel.
# SMTP_ALLOW_SELF_SIGNED=true
